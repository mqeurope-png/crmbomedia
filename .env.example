APP_NAME="CRMBO Media CRM"
ENVIRONMENT=development
# Quoting rule: values that contain spaces or shell-special characters must
# be wrapped in double quotes. Docker Compose strips them automatically and
# the backup scripts use a parser that does the same, so a value like
# `SMTP_FROM_NAME="CRMBO Media CRM"` works everywhere. Unquoted spaces
# break any tool that reads this file via shell `source`.
DATABASE_URL=mysql+pymysql://crm:crm@localhost:3306/crm
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
SECRET_KEY=change-me-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=change-me-admin-password

# Fernet key (44-char urlsafe base64) used to encrypt integration API keys
# at rest. Required: the app refuses to start without it. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this key invalidates all stored ciphertext — see docs/security.md.
INTEGRATION_SECRETS_KEY=replace-with-fernet-key

# Public URL of the frontend, used to build the password-reset link inside
# the email body. In development the default is fine; in production set it
# to the public domain (e.g. https://crm.tudominio.com).
FRONTEND_BASE_URL=http://localhost:3000

# SMTP / email service. Leave SMTP_HOST empty in development: the app falls
# back to ConsoleEmailService and prints the rendered email to stdout. To
# enable real delivery in production, fill all of SMTP_HOST/PORT/USER/
# PASSWORD/FROM in .env.production and set ENVIRONMENT=production.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_FROM_NAME="CRMBO Media CRM"
# SMTP_USE_TLS=true   # STARTTLS on port 587
# SMTP_USE_SSL=false  # implicit SSL on port 465; mutually exclusive with TLS

# Error tracking. Leave SENTRY_DSN / NEXT_PUBLIC_SENTRY_DSN empty in dev so
# the SDK stays uninitialized and no events are sent. See docs/security.md
# "Error tracking" for the privacy contract (send_default_pii=false +
# before_send scrubbing of password/token/email).
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# GIT_SHA=                  # CI sets this from $GITHUB_SHA; release tag in Sentry
# NEXT_PUBLIC_GIT_SHA=      # mirror exposed to the browser bundle

# Activar logging detallado de requests a APIs externas. Cuando vale
# "true"/"1"/"yes" el `IntegrationHTTPClient` emite un INFO por cada
# llamada (método, URL completa, headers con Authorization enmascarado)
# y un ERROR por cada respuesta 4xx/5xx (status + headers + primeros
# 2000 chars del body). Mantener desactivado salvo en debugging puntual.
# INTEGRATION_HTTP_DEBUG=false

# --- BoHub ERP Sprint 0 (prototipo, credenciales SOLO en .env.local) --------
# FACTUSOL / API DELSOL (https://apidoc.sdelsol.com/). Bart habilita el
# acceso API en el hosting DELSOL de Bomedia antes de rellenar esto.
# FACTUSOL_API_BASE_URL=
# FACTUSOL_API_CODE=
# FACTUSOL_API_USER=
# FACTUSOL_API_PASSWORD=
# FACTUSOL_EXERCISE=2026

# WooCommerce (una tienda por variable-prefijo; multi-tienda real irá en
# integration_accounts). Generar en WP admin → WooCommerce → REST API.
# WOO_MBOLASERS_BASE_URL=https://mbolasers.com
# WOO_MBOLASERS_CONSUMER_KEY=
# WOO_MBOLASERS_CONSUMER_SECRET=
# WOO_MBOLASERS_WEBHOOK_SECRET=

# Genei (paquetería) + DSV (palés) — ver docs/erp/logistics-genei-dsv.md
# GENEI_API_KEY=
# DSV_API_KEY=
