# Zonas de rate limit (contexto http) — fichero canónico de zonas.
#
# Se incluye vía `include /etc/nginx/conf.d/*.conf;` de `nginx.conf`, que está
# dentro del bloque `http {}`, así que estas directivas quedan en contexto http
# (donde `limit_req_zone` es válido). Las locations que las usan
# (`limit_req zone=webhooks ...` en `app.conf`) pueden referenciarlas aunque se
# definan en otro fichero incluido: nginx resuelve las zonas tras parsear todo.
#
# IMPORTANTE: definir una zona aquí Y en `nginx.conf` a la vez hace que nginx
# falle al arrancar («duplicate zone "webhooks"») → 502. La zona vive SOLO aquí.
#
# Deploy: se copia a `zones.conf` (que está en .gitignore, como app.conf):
#   cp deploy/nginx/conf.d/zones.conf.example deploy/nginx/conf.d/zones.conf

# Rate limit para los receptores de webhooks (WooCommerce B-3, Genei B-4).
# WooCommerce nunca debería exceder ~10 req/s; el burst absorbe ráfagas de
# reintentos.
limit_req_zone $binary_remote_addr zone=webhooks:10m rate=10r/s;
